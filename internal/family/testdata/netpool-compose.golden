    entrypoint: ["/bin/sh", "-c", "while IFS= read -r p; do if [ ! -e \"$$p\" ]; then echo missing; elif [ ! -f \"$$p\" ]; then echo notfile; elif [ ! -r \"$$p\" ]; then echo unreadable; else echo \"ok $$(stat -L -c %a \"$$p\")\"; fi; done", "homefiles"]
    network_mode: none
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp:size=16m"]
    pids_limit: 256
    mem_limit: 512m
    volumes:
      - "db-c-home:/home/locksql"
      - "profile-locksql:/w/one/.locksql:ro"
  "homecopy-db-c":
    image: "ghcr.io/davidgodefroid/locksql@sha256:2222222222222222222222222222222222222222222222222222222222222222"
    profiles: [setup]
    user: "10001:10000"
    entrypoint: ["/bin/sh", "-c", "umask 077 && mkdir -p \"$$(dirname \"$$1\")\" && cat > \"$$1\"", "homecopy"]
    network_mode: none
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp:size=16m"]
    pids_limit: 256
    mem_limit: 512m
    volumes:
      - "db-c-home:/home/locksql"
  "profile-lockfile":
    image: "ghcr.io/davidgodefroid/lockfile@sha256:4444444444444444444444444444444444444444444444444444444444444444"
    profiles: [setup]
    user: "0:0"
    entrypoint: ["/bin/sh", "-c", "find /p -mindepth 1 -delete && head -c 526336 | tar -x -C /p && chown 10031:10030 /p && chmod 0700 /p"]
    network_mode: none
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp:size=16m"]
    pids_limit: 256
    mem_limit: 512m
    cap_add: [CHOWN, FOWNER, DAC_OVERRIDE]
    volumes:
      - "profile-lockfile:/p"
  "profile-lockhttp":
    image: "ghcr.io/davidgodefroid/lockhttp@sha256:4444444444444444444444444444444444444444444444444444444444444444"
    profiles: [setup]
    user: "0:0"
    entrypoint: ["/bin/sh", "-c", "find /p -mindepth 1 -delete && head -c 526336 | tar -x -C /p && chown 10021:10020 /p && chmod 0700 /p"]
    network_mode: none
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp:size=16m"]
    pids_limit: 256
    mem_limit: 512m
    cap_add: [CHOWN, FOWNER, DAC_OVERRIDE]
    volumes:
      - "profile-lockhttp:/p"
  "profile-lockmq":
    image: "ghcr.io/davidgodefroid/lockmq@sha256:3333333333333333333333333333333333333333333333333333333333333333"
    profiles: [setup]
    user: "0:0"
    entrypoint: ["/bin/sh", "-c", "find /p -mindepth 1 -delete && head -c 526336 | tar -x -C /p && chown 10011:10010 /p && chmod 0700 /p"]
    network_mode: none
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp:size=16m"]
    pids_limit: 256
    mem_limit: 512m
    cap_add: [CHOWN, FOWNER, DAC_OVERRIDE]
    volumes:
      - "profile-lockmq:/p"
  "profile-locksql":
    image: "ghcr.io/davidgodefroid/locksql@sha256:2222222222222222222222222222222222222222222222222222222222222222"
    profiles: [setup]
    user: "0:0"
    entrypoint: ["/bin/sh", "-c", "find /p -mindepth 1 -delete && head -c 526336 | tar -x -C /p && chown 10001:10000 /p && chmod 0700 /p"]
    network_mode: none
    read_only: true
