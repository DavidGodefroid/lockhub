      HOME: "/home/locksql"
      LOCKSQL_PII_DIR: "/home/locksql/pii-rules"
    working_dir: "/w/one"
    command: ["console", "--hub", "http://lockhub:8443", "--hub-plain-http", "--hub-key-file", "/run/lockfamily/hub.pub", "--instance", "db-a"]
    logging:
