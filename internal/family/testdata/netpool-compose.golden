    image: "ghcr.io/davidgodefroid/lockhub@sha256:1111111111111111111111111111111111111111111111111111111111111111"
    profiles: [setup]
    user: "0:0"
    entrypoint: ["/bin/sh", "-c", "umask 022 && printf '%s\\n' \"$1\" > /k/hub.pub.new && mv /k/hub.pub.new /k/hub.pub", "hubkey"]
    network_mode: none
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp:size=16m"]
    pids_limit: 256
    mem_limit: 512m
    volumes:
      - hubkey:/k
