    entrypoint: ["/bin/sh", "-c", "umask 022 && printf '%s\\n' \"$1\" > /k/hub.pub.new && mv /k/hub.pub.new /k/hub.pub", "hubkey"]
    network_mode: none
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp:size=16m"]
    pids_limit: 256
    mem_limit: 512m
    volumes:
      - hubkey:/k
  lock-db:
    image: "ghcr.io/davidgodefroid/locksql@sha256:2222222222222222222222222222222222222222222222222222222222222222"
    user: "10001:10000"
    tty: true
    stdin_open: true
    environment:
      HOME: "/home/locksql"
      LOCKSQL_PII_DIR: "/home/locksql/pii-rules"
      VAULT_ADDR: "http://host.docker.internal:8200"
    working_dir: "/w"
    command: ["console", "--hub", "http://lockhub:8443", "--hub-plain-http", "--hub-key-file", "/run/lockfamily/hub.pub", "--instance", "db"]
    logging:
      driver: none
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp:size=16m"]
    pids_limit: 256
    mem_limit: 1g
    volumes:
      - "db-run:/run/locksql"
      - "db-home:/home/locksql"
      - hubkey:/run/lockfamily:ro
      - "profile-locksql:/w/.locksql:ro"
    networks: [lockhub, "egress-db"]
    depends_on: [lockhub, "gw-db"]
    restart: unless-stopped
  "gw-db":
    image: "ghcr.io/davidgodefroid/lockhub@sha256:1111111111111111111111111111111111111111111111111111111111111111"
    read_only: true
