services:
  lockhub:
    image: "ghcr.io/davidgodefroid/lockhub@sha256:1111111111111111111111111111111111111111111111111111111111111111"
    user: "0:0"
    command: ["serve", "--listen", ":8443", "--data", "/var/lib/lockhub", "--facade-socket", "/run/lockhub-facade/facade.sock"]
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp:size=16m"]
    pids_limit: 256
    mem_limit: 512m
    volumes:
      - type: bind
        source: "/s/hub"
        target: /var/lib/lockhub
      - type: bind
        source: "/r/lockhub"
        target: /run/lockhub-facade
        bind:
          create_host_path: false
